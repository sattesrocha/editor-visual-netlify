{
  "name": "Editor Visual para sites no Netlify",
  "short_name": "Editor Visual",
  "description": "Edite seu site hospedado no Netlify como no WordPress: textos, imagens e seções, sem programar.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
